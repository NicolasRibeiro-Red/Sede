# Release allowlist: only runtime, public documentation and reproducible checks.
/*
!/.gitignore
!/.gitattributes
!/.github/
!/README.md
!/THIRD_PARTY_NOTICES.md
!/package.json
!/server.mjs
!/tests/
!/docs/
!/sede-3d/
!/cube-world-lab/

/sede-3d/*
!/sede-3d/*.js
!/sede-3d/*.css
!/sede-3d/index.html
!/sede-3d/assets/
/sede-3d/protester.js
/sede-3d/app.js

/cube-world-lab/*
!/cube-world-lab/appearance.js
!/cube-world-lab/accessories.js
!/cube-world-lab/assets/
!/cube-world-lab/vendor/

/docs/*
!/docs/preview.jpg

**/.env*
**/node_modules/
**/*.log
**/.DS_Store
**/Thumbs.db
